model course {
  id          Int      @id @default(autoincrement()) // FIX: Added ()
  name        String
  shortdes    String
  longdes     String
  imageurl    String
  language    String
  totaltime   Int      // FIX: Changed 'int' to 'Int'
  discount    Int

  // Relation to Category
  categoryId  Int?
  category    category? @relation(fields: [categoryId], references: [id])

  // Relation to Modules
  courseModules Module[] // FIX: Renamed 'modules' to 'Module'

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}




