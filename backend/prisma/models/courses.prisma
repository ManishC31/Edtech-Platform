model Category {
  id        Int      @id @default(autoincrement())
  name      String
  courses   Course[] // Relation to courses
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Course {
  id          Int      @id @default(autoincrement()) // FIX: Added ()
  name        String
  shortDes    String
  longDes     String
  imageUrl    String
  language    String
  totalTime   Int      // FIX: Changed 'int' to 'Int'
  discount    Int

  // Relation to Category
  categoryId  Int?
  category    Category? @relation(fields: [categoryId], references: [id])

  // Relation to Modules
  courseModules Module[] // FIX: Renamed 'modules' to 'Module'

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Module {
  id            Int      @id @default(autoincrement()) // FIX: Added ()
  name          String
  totalLectures Int
  totalMins     Int
  totalVideos   Int

  // Relation to Course
  courseId      Int
  course        Course   @relation(fields: [courseId], references: [id])
  
  // Relation to Videos
  videos        Video[]  // FIX: Renamed 'videos' to 'Video'

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Video {
  id        Int      @id @default(autoincrement())
  title     String
  fileUrl   String
  timeMins  Int

  // Relation to Module
  module    Module   @relation(fields: [moduleId], references: [id])
  moduleId  Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
