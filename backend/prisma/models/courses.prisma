model category {
  id        Int      @id @default(autoincrement())
  name      String
  courses   course[] // Relation to courses
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model course {
  id          Int      @id @default(autoincrement()) // FIX: Added ()
  name        String
  shortdes    String
  longdes     String
  imageurl    String
  language    String
  totaltime   Int      // FIX: Changed 'int' to 'Int'
  discount    Int

  // Relation to Category
  categoryId  Int?
  category    category? @relation(fields: [categoryId], references: [id])

  // Relation to Modules
  courseModules Module[] // FIX: Renamed 'modules' to 'Module'

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Module {
  id            Int      @id @default(autoincrement()) // FIX: Added ()
  name          String
  totalLectures Int
  totalMins     Int
  totalVideos   Int

  // Relation to Course
  courseId      Int
  course        course   @relation(fields: [courseId], references: [id])
  
  // Relation to Videos
  videos        Video[]  // FIX: Renamed 'videos' to 'Video'

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Video {
  id        Int      @id @default(autoincrement())
  title     String
  fileUrl   String
  timeMins  Int

  // Relation to Module
  module    Module   @relation(fields: [moduleId], references: [id])
  moduleId  Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

}


