model video {
  id           Int    @id @default(autoincrement())
  title        String
  file_url     String
  time_mins    Int
  resource_url String

  // Relation to Module
  module    module @relation(fields: [module_id], references: [id])
  module_id Int

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}
