model module {
  id             Int    @id @default(autoincrement())
  name           String
  total_lectures Int
  total_mins     Int
  total_videos   Int

  // Relation to Course
  course_id Int
  course    course @relation(fields: [course_id], references: [id])

  // Relation to Videos
  videos        video[]  // FIX: Renamed 'videos' to 'Video'

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}
